# Copy to .env (cp .env.example .env) and adjust. Never commit .env.
# Inside containers, docker/compose.env pins the network topology (db host/port).

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-outside-local-dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# --- PostgreSQL ---
POSTGRES_DB=cotador
POSTGRES_USER=cotador
POSTGRES_PASSWORD=cotador-local
# Used when running the backend outside Docker (defaults: localhost / 5432).
# Point POSTGRES_PORT at POSTGRES_PUBLISHED_PORT if you change it.
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# Host port where the compose database is published (change it if 5432 is taken).
POSTGRES_PUBLISHED_PORT=5432

# --- Frontend ---
# Host port where the compose web app is published.
FRONTEND_PORT=8080

# --- Demo ---
# Enables the demo panel (simulates the arrival of fictional operator material).
DEMO_MODE=true
# Password for the demo users created by the seed (analista and revisor).
DEMO_PASSWORD=cotador-demo

# --- ANS open data ---
ANS_OPEN_DATA_BASE_URL=https://dadosabertos.ans.gov.br/FTP/PDA

# --- AI extraction (optional) ---
# Without a key, non-tabular layouts are left for manual handling.
# ANTHROPIC_API_KEY=
# LLM_EXTRACTION_MODEL=
